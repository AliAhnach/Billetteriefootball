<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Inscription</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-14" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="publicNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Accueil</a><a class="nav-link" href="${pageContext.request.contextPath}/login">Connexion</a><a class="btn btn-warning btn-sm active" href="${pageContext.request.contextPath}/inscription">Créer un compte</a></div></div></div></nav><main class="container"><section class="card card-football auth-card"><div class="card-body p-4 p-md-5"><span class="badge text-bg-success mb-2">Nouveau compte</span><h1 class="h2 fw-bold">Créer votre compte</h1><p class="text-muted-football">Inscrivez-vous pour réserver vos places.</p><p class="text-danger">${erreur}</p>
<form method="post" action="${pageContext.request.contextPath}/inscription"><div class="mb-3"><label class="form-label" for="nom">Nom complet</label><input class="form-control form-control-lg" id="nom" name="nom" required></div><div class="mb-3"><label class="form-label" for="email">Adresse e-mail</label><input class="form-control form-control-lg" id="email" type="email" name="email" required></div><div class="mb-4"><label class="form-label" for="password">Mot de passe</label><div class="password-input-wrap"><input class="form-control form-control-lg" id="password" type="password" name="motDePasse" required><button class="password-toggle" type="button" data-password-target="password" aria-label="Afficher le mot de passe" aria-pressed="false"><svg class="password-eye-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div><button class="btn btn-football btn-lg w-100" type="submit">Créer mon compte</button></form></div></section></main><script src="${pageContext.request.contextPath}/js/password-toggle.js?v=1"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
