<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Mon profil — Billetterie</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-4" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span>FootTicket</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="userNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Matchs</a><a class="nav-link" href="${pageContext.request.contextPath}/billets">Mes réservations</a><a class="nav-link active" href="${pageContext.request.contextPath}/profil">Mon profil</a><c:choose><c:when test="${not empty sessionScope.photoProfilFichier}"><img class="profile-avatar profile-avatar-small" width="32" height="32" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil"></c:when><c:otherwise><span class="profile-avatar profile-avatar-small" aria-hidden="true">👤</span></c:otherwise></c:choose><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav>
<main class="container py-5"><header class="page-header pt-0"><span class="badge text-bg-success mb-2">Votre compte</span><h1 class="display-6 fw-bold">Mon profil</h1><p>Modifiez vos coordonnées, votre mot de passe ou votre photo.</p></header>
<c:if test="${param.message eq 'modifie'}"><div class="alert alert-success">Votre profil a été mis à jour.</div></c:if><c:if test="${not empty erreur}"><div class="alert alert-danger" role="alert"><c:out value="${erreur}"/></div></c:if>
<div class="card card-football" style="max-width: 760px"><div class="card-body p-4 p-md-5"><form method="post" action="${pageContext.request.contextPath}/profil" enctype="multipart/form-data"><div class="d-flex align-items-center gap-3 mb-4"><c:choose><c:when test="${not empty profil.photoProfilFichier}"><img class="profile-avatar profile-avatar-large" width="64" height="64" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil actuelle"></c:when><c:otherwise><span class="profile-avatar profile-avatar-large" aria-hidden="true">👤</span></c:otherwise></c:choose><div><label class="form-label fw-semibold" for="photoProfil">Photo de profil</label><input class="form-control" id="photoProfil" name="photoProfil" type="file" accept="image/png,image/jpeg,image/webp"><div class="form-text">PNG, JPEG ou WebP, 3 Mo maximum.</div></div></div>
<div class="mb-3"><label class="form-label" for="nom">Nom</label><input class="form-control" id="nom" name="nom" type="text" maxlength="100" value="<c:out value='${profil.nom}'/>" required></div><div class="mb-3"><label class="form-label" for="email">Adresse e-mail</label><input class="form-control" id="email" name="email" type="email" value="<c:out value='${profil.email}'/>" required></div><hr class="my-4"><h2 class="h5 fw-bold">Changer le mot de passe</h2><p class="text-muted-football">Laissez les champs vides pour conserver votre mot de passe actuel.</p><div class="mb-3"><label class="form-label" for="nouveauMotDePasse">Nouveau mot de passe</label><input class="form-control" id="nouveauMotDePasse" name="nouveauMotDePasse" type="password" minlength="8" autocomplete="new-password"></div><div class="mb-4"><label class="form-label" for="confirmationMotDePasse">Confirmer le nouveau mot de passe</label><input class="form-control" id="confirmationMotDePasse" name="confirmationMotDePasse" type="password" minlength="8" autocomplete="new-password"></div><button class="btn btn-football" type="submit">Enregistrer les modifications</button></form></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
