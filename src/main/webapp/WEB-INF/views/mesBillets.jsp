<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Mes réservations</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-4" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span>FootTicket</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="userNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Matchs</a><a class="nav-link active" href="${pageContext.request.contextPath}/billets">Mes réservations</a><a class="nav-link" href="${pageContext.request.contextPath}/profil">Mon profil</a><c:if test="${not empty sessionScope.photoProfilFichier}"><img class="profile-avatar profile-avatar-small" width="32" height="32" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil"></c:if><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav><main class="container py-5"><header class="page-header pt-0"><span class="badge text-bg-success mb-2">Billetterie</span><h1 class="display-6 fw-bold">Mes réservations</h1><p>Suivez l’état de vos demandes. Elles restent en attente jusqu’à leur validation par l’administration.</p></header><c:if test="${param.message eq 'annulee'}"><div class="alert alert-success">Votre réservation a été annulée.</div></c:if><c:if test="${param.message eq 'supprimee'}"><div class="alert alert-success">Votre réservation a été supprimée.</div></c:if><c:if test="${not empty erreur}"><div class="alert alert-danger"><c:out value="${erreur}"/></div></c:if><div class="card card-football"><div class="card-body p-0"><c:if test="${empty reservations}"><p class="p-4 mb-0">Vous n’avez pas encore de réservation. <a href="${pageContext.request.contextPath}/matchs">Voir les matchs</a></p></c:if><c:if test="${not empty reservations}"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-4">Réservation</th><th>Match</th><th>Tribune</th><th>Places</th><th>Date</th><th>Statut</th><th>Actions</th></tr></thead><tbody><c:forEach var="reservation" items="${reservations}"><tr><td class="ps-4 fw-semibold">#<c:out value="${reservation.id}"/></td><td>Match #<c:out value="${reservation.matchId}"/></td><td><c:choose><c:when test="${not empty reservation.categorie}"><c:out value="${reservation.categorie}"/></c:when><c:otherwise>À attribuer</c:otherwise></c:choose></td><td><c:out value="${reservation.nombrePlaces}"/></td><td><c:out value="${reservation.dateReservation}"/></td><td><c:choose><c:when test="${reservation.statut eq 'EN_ATTENTE'}"><span class="badge text-bg-warning">En attente de validation</span></c:when><c:when test="${reservation.statut eq 'VALIDEE'}"><span class="badge text-bg-success">Validée</span></c:when><c:when test="${reservation.statut eq 'ANNULEE'}"><span class="badge text-bg-secondary">Annulée</span></c:when><c:otherwise><span class="badge text-bg-light"><c:out value="${reservation.statut}"/></span></c:otherwise></c:choose></td><td><div class="d-flex flex-wrap gap-2"><c:if test="${reservation.statut eq 'VALIDEE'}"><a class="btn btn-football btn-sm" href="${pageContext.request.contextPath}/billets?billet=${reservation.id}">Télécharger mon billet (PDF)</a></c:if><c:if test="${reservation.statut ne 'ANNULEE'}"><form method="post" action="${pageContext.request.contextPath}/billets"><input type="hidden" name="reservationId" value="${reservation.id}"><input type="hidden" name="action" value="annuler"><button class="btn btn-outline-secondary btn-sm" type="submit">Annuler</button></form></c:if><form method="post" action="${pageContext.request.contextPath}/billets" onsubmit="return confirm('Supprimer définitivement cette réservation ?');"><input type="hidden" name="reservationId" value="${reservation.id}"><input type="hidden" name="action" value="supprimer"><button class="btn btn-outline-danger btn-sm" type="submit">Supprimer</button></form></div></td></tr></c:forEach></tbody></table></div></c:if></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
