<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Mes billets</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css" rel="stylesheet"></head><body><nav class="navbar navbar-football"><div class="container"><a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/matchs">⚽ Billetterie</a></div></nav><main class="container py-5"><header class="page-header pt-0"><span class="badge text-bg-success mb-2">Billetterie</span><h1 class="display-6 fw-bold">Mes billets</h1><p>Retrouvez les billets associés à votre sélection.</p></header><div class="card card-football"><div class="card-body p-0"><c:if test="${empty billets}"><p class="p-4 mb-0">Aucun billet à afficher.</p></c:if><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-4">Catégorie</th><th>Prix</th><th>Disponibilité</th></tr></thead><tbody><c:forEach var="billet" items="${billets}"><tr><td class="ps-4 fw-semibold"><c:out value="${billet.categorie}"/></td><td><c:out value="${billet.prix}"/></td><td><c:if test="${billet.disponible}"><span class="badge text-bg-success">Disponible</span></c:if><c:if test="${not billet.disponible}"><span class="badge text-bg-secondary">Indisponible</span></c:if></td></tr></c:forEach></tbody></table></div></div></div></main></body></html>
