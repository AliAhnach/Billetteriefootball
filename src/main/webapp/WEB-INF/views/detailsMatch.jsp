<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Détail du match</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-12" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="userNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><c:choose><c:when test="${empty sessionScope.role}"><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Accueil</a></c:when><c:otherwise><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Matchs</a></c:otherwise></c:choose><a class="nav-link" href="${pageContext.request.contextPath}/billets">Mes réservations</a><a class="nav-link" href="${pageContext.request.contextPath}/profil">Mon profil</a><c:if test="${not empty sessionScope.photoProfilFichier}"><img class="profile-avatar profile-avatar-small" width="32" height="32" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil"></c:if><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav><main class="container py-5"><article class="card card-football mx-auto" style="max-width: 760px"><div class="card-body p-4 p-md-5">
<div class="competition-label mb-4"><c:if test="${match.competition eq 'Botola Pro'}"><span class="competition-logo-frame competition-logo-frame-large"><img class="competition-logo" src="${pageContext.request.contextPath}/images/logos/botola-pro.png" alt="Logo Botola Pro"></span></c:if><span class="badge text-bg-success"><c:out value="${match.competition}"/></span></div>
<div class="match-teams match-teams-detail"><div class="match-team"><c:choose><c:when test="${not empty match.photoDomicileFichier}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/photoMatch?id=${match.id}&amp;equipe=domicile" alt="Logo ${match.equipeDomicile}"></span></c:when><c:when test="${match.equipeDomicile eq 'Raja Casablanca'}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/raja.png" alt="Logo Raja Casablanca"></span></c:when><c:when test="${match.equipeDomicile eq 'Wydad Casablanca'}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/wydad.png" alt="Logo Wydad Casablanca"></span></c:when></c:choose><span><c:out value="${match.equipeDomicile}"/></span></div><span class="match-vs">vs</span><div class="match-team"><c:choose><c:when test="${not empty match.photoExterieureFichier}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/photoMatch?id=${match.id}&amp;equipe=exterieure" alt="Logo ${match.equipeExterieure}"></span></c:when><c:when test="${match.equipeExterieure eq 'Raja Casablanca'}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/raja.png" alt="Logo Raja Casablanca"></span></c:when><c:when test="${match.equipeExterieure eq 'Wydad Casablanca'}"><span class="team-logo-frame team-logo-frame-large"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/wydad.png" alt="Logo Wydad Casablanca"></span></c:when></c:choose><span><c:out value="${match.equipeExterieure}"/></span></div></div>
<p class="lead text-muted-football mt-4"><c:out value="${match.stade}"/> · <c:out value="${match.dateHeureAffichee}"/></p><p class="h5 fw-bold">À partir de <c:out value="${match.prix}"/> DH</p>
<a class="btn btn-football btn-lg mt-3" href="${pageContext.request.contextPath}/reservation?matchId=${match.id}">Réserver une place</a> <a class="btn btn-outline-secondary btn-lg mt-3" href="${pageContext.request.contextPath}/matchs">Retour</a></div></article></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
