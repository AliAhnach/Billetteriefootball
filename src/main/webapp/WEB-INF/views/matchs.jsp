<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Matchs disponibles</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-12" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="userNav"><c:if test="${sessionScope.role ne 'ADMIN'}"><form class="navbar-search-form d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0" method="get" action="${pageContext.request.contextPath}/matchs" role="search"><input class="form-control" type="search" name="q" value="<c:out value='${recherche}'/>" placeholder="Rechercher un match, une équipe..." aria-label="Rechercher un match ou une équipe"><button class="navbar-search-button" type="submit" aria-label="Rechercher"><svg class="navbar-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form></c:if><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><c:choose><c:when test="${empty sessionScope.role}"><a class="nav-link active" href="${pageContext.request.contextPath}/matchs">Accueil</a></c:when><c:otherwise><a class="nav-link active" href="${pageContext.request.contextPath}/matchs">Matchs</a></c:otherwise></c:choose><c:choose><c:when test="${not empty sessionScope.nom}"><c:if test="${sessionScope.role eq 'CLIENT'}"><a class="nav-link" href="${pageContext.request.contextPath}/billets">Mes réservations</a><a class="nav-link" href="${pageContext.request.contextPath}/profil">Mon profil</a><c:if test="${not empty sessionScope.photoProfilFichier}"><img class="profile-avatar profile-avatar-small" width="32" height="32" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil"></c:if></c:if><c:if test="${sessionScope.role eq 'ADMIN'}"><a class="nav-link" href="${pageContext.request.contextPath}/admin">Administration</a></c:if><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></c:when><c:otherwise><a class="nav-link" href="${pageContext.request.contextPath}/login">Connexion</a><a class="btn btn-success btn-sm" href="${pageContext.request.contextPath}/inscription">Créer un compte</a></c:otherwise></c:choose></div></div></div></nav>
<main class="container py-4"><header class="page-header"><span class="badge text-bg-success mb-2">Calendrier</span><h1 class="display-6 fw-bold">Matchs disponibles</h1><p>Choisissez votre prochaine rencontre et réservez votre place.</p></header>
<c:if test="${empty matchs}"><div class="alert alert-light border"><c:choose><c:when test="${not empty recherche}">Aucun match ne correspond à « <c:out value="${recherche}"/> ».</c:when><c:otherwise>Aucun match disponible pour le moment.</c:otherwise></c:choose></div></c:if>
<div class="row g-3"><c:forEach var="match" items="${matchs}"><div class="col-12 col-md-6 col-xl-4"><article class="card card-football match-card h-100"><div class="card-body p-4">
<div class="competition-label mb-3"><c:if test="${match.competition eq 'Botola Pro'}"><span class="competition-logo-frame"><img class="competition-logo" src="${pageContext.request.contextPath}/images/logos/botola-pro.png" alt="Logo Botola Pro" loading="lazy"></span></c:if><span class="badge rounded-pill text-bg-light"><c:out value="${match.competition}"/></span></div>
<div class="match-teams"><div class="match-team"><c:choose><c:when test="${not empty match.photoDomicileFichier}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/photoMatch?id=${match.id}&amp;equipe=domicile" alt="Logo ${match.equipeDomicile}" loading="lazy"></span></c:when><c:when test="${match.equipeDomicile eq 'Raja Casablanca'}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/raja.png" alt="Logo Raja Casablanca" loading="lazy"></span></c:when><c:when test="${match.equipeDomicile eq 'Wydad Casablanca'}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/wydad.png" alt="Logo Wydad Casablanca" loading="lazy"></span></c:when></c:choose><span><c:out value="${match.equipeDomicile}"/></span></div><img class="match-vs-icon" src="${pageContext.request.contextPath}/images/icones/VS-icone.png" alt="VS"><div class="match-team"><c:choose><c:when test="${not empty match.photoExterieureFichier}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/photoMatch?id=${match.id}&amp;equipe=exterieure" alt="Logo ${match.equipeExterieure}" loading="lazy"></span></c:when><c:when test="${match.equipeExterieure eq 'Raja Casablanca'}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/raja.png" alt="Logo Raja Casablanca" loading="lazy"></span></c:when><c:when test="${match.equipeExterieure eq 'Wydad Casablanca'}"><span class="team-logo-frame"><img class="team-logo" src="${pageContext.request.contextPath}/images/logos/wydad.png" alt="Logo Wydad Casablanca" loading="lazy"></span></c:when></c:choose><span><c:out value="${match.equipeExterieure}"/></span></div></div>
<div class="match-meta text-muted-football mb-3"><p><img src="${pageContext.request.contextPath}/images/icones/stadium-icone.png" alt="Stade"><span><c:out value="${match.stade}"/></span></p><p><img src="${pageContext.request.contextPath}/images/icones/time-icone.png" alt="Date et heure"><span><c:out value="${match.dateHeureAffichee}"/></span></p></div><p class="fw-semibold mb-4">À partir de <c:out value="${match.prix}"/> DH</p><a class="btn btn-football" href="${pageContext.request.contextPath}/match?id=${match.id}">Voir le match</a>
</div></article></div></c:forEach></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
