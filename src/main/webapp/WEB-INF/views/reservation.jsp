<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Réservation</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css" rel="stylesheet"></head><body><nav class="navbar navbar-football"><div class="container"><a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/matchs">⚽ Billetterie</a></div></nav><main class="container"><section class="card card-football auth-card"><div class="card-body p-4 p-md-5"><span class="badge text-bg-success mb-2">Réservation</span><h1 class="h2 fw-bold">Choisissez votre place</h1><p class="text-muted-football">Votre place sera bloquée pendant la réservation.</p><p class="text-danger">${erreur}</p><form method="post" action="${pageContext.request.contextPath}/reserver"><input type="hidden" name="matchId" value="${param.matchId}"><div class="mb-4"><label class="form-label" for="place">Numéro de place</label><input class="form-control form-control-lg" id="place" type="number" name="placeId" min="1" required></div><button class="btn btn-football btn-lg w-100" type="submit">Confirmer la réservation</button></form></div></section></main></body></html>
