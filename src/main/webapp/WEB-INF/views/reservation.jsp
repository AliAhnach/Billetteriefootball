<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Réservation</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-12" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/matchs"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="userNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="${pageContext.request.contextPath}/matchs">Matchs</a><a class="nav-link" href="${pageContext.request.contextPath}/billets">Mes réservations</a><a class="nav-link" href="${pageContext.request.contextPath}/profil">Mon profil</a><c:if test="${not empty sessionScope.photoProfilFichier}"><img class="profile-avatar profile-avatar-small" width="32" height="32" src="${pageContext.request.contextPath}/profil/photo" alt="Photo de profil"></c:if><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav><main class="container"><section class="card card-football auth-card"><div class="card-body p-4 p-md-5"><span class="badge text-bg-success mb-2">Réservation</span><h1 class="h2 fw-bold">Réservez vos places</h1><p class="text-muted-football">Choisissez la tribune et le nombre de places souhaité.</p><c:if test="${not empty erreur}"><div class="alert alert-danger" role="alert"><c:out value="${erreur}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/reserver"><input type="hidden" name="matchId" value="${param.matchId}"><div class="mb-4"><label class="form-label" for="categorie">Catégorie de place (tribune)</label><select class="form-select form-select-lg" id="categorie" name="categorie" required><option value="" selected disabled>Choisissez une tribune</option><option value="Tribune centrale" data-prix="${tarifs['Tribune centrale']}">Tribune centrale<c:choose><c:when test="${not empty tarifs['Tribune centrale']}"> — <c:out value="${tarifs['Tribune centrale']}"/> DH / place</c:when><c:otherwise> — Tarif à confirmer</c:otherwise></c:choose></option><option value="Tribune latérale" data-prix="${tarifs['Tribune latérale']}">Tribune latérale<c:choose><c:when test="${not empty tarifs['Tribune latérale']}"> — <c:out value="${tarifs['Tribune latérale']}"/> DH / place</c:when><c:otherwise> — Tarif à confirmer</c:otherwise></c:choose></option><option value="Tribune populaire" data-prix="${tarifs['Tribune populaire']}">Tribune populaire<c:choose><c:when test="${not empty tarifs['Tribune populaire']}"> — <c:out value="${tarifs['Tribune populaire']}"/> DH / place</c:when><c:otherwise> — Tarif à confirmer</c:otherwise></c:choose></option></select></div><div class="mb-4"><label class="form-label" for="nombrePlaces">Nombre de places à réserver</label><input class="form-control form-control-lg" id="nombrePlaces" type="number" name="nombrePlaces" min="1" max="10" value="1" required><div class="form-text">Vous pouvez réserver jusqu’à 10 places.</div></div><div class="reservation-price mb-4" aria-live="polite"><div>Prix par place : <strong id="prixUnitaire">—</strong></div><div>Total estimé : <strong id="prixTotal">—</strong></div></div><button class="btn btn-football btn-lg w-100" type="submit">Confirmer la réservation</button></form></div></section></main><script>
(() => {
  const category = document.getElementById('categorie');
  const quantity = document.getElementById('nombrePlaces');
  const unit = document.getElementById('prixUnitaire');
  const total = document.getElementById('prixTotal');
  const formatDh = value => new Intl.NumberFormat('fr-MA', { style: 'currency', currency: 'MAD' }).format(value);
  const updatePrice = () => {
    const option = category.options[category.selectedIndex];
    const priceValue = option ? option.dataset.prix : '';
    const price = priceValue ? Number(priceValue) : NaN;
    const count = Number(quantity.value);
    unit.textContent = Number.isFinite(price) ? formatDh(price) : (category.value ? 'Tarif à confirmer' : '—');
    total.textContent = Number.isFinite(price) && count > 0 ? formatDh(price * count) : (category.value ? 'À confirmer' : '—');
  };
  category.addEventListener('change', updatePrice);
  quantity.addEventListener('input', updatePrice);
})();
</script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
