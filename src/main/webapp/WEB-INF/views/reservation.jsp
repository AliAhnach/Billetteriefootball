<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Réservation</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=reservation-2" rel="stylesheet"></head><body><nav class="navbar navbar-football"><div class="container"><a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/matchs">⚽ Billetterie</a></div></nav><main class="container"><section class="card card-football auth-card"><div class="card-body p-4 p-md-5"><span class="badge text-bg-success mb-2">Réservation</span><h1 class="h2 fw-bold">Réservez vos places</h1><p class="text-muted-football">Choisissez la tribune et le nombre de places souhaité.</p><c:if test="${not empty erreur}"><div class="alert alert-danger" role="alert"><c:out value="${erreur}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/reserver"><input type="hidden" name="matchId" value="${param.matchId}"><div class="mb-4"><label class="form-label" for="categorie">Catégorie de place (tribune)</label><select class="form-select form-select-lg" id="categorie" name="categorie" required><option value="" selected disabled>Choisissez une tribune</option><option value="Tribune centrale">Tribune centrale</option><option value="Tribune latérale">Tribune latérale</option><option value="Tribune populaire">Tribune populaire</option></select></div><div class="mb-4"><label class="form-label" for="nombrePlaces">Nombre de places à réserver</label><input class="form-control form-control-lg" id="nombrePlaces" type="number" name="nombrePlaces" min="1" max="10" value="1" required><div class="form-text">Vous pouvez réserver jusqu’à 10 places.</div></div><button class="btn btn-football btn-lg w-100" type="submit">Confirmer la réservation</button></form></div></section></main></body></html>
