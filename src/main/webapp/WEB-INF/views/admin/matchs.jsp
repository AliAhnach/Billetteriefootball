<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Administration — Matchs</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-12" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/admin"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="adminNav"><form class="navbar-search-form d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0" method="get" action="${pageContext.request.contextPath}/admin/matchs" role="search"><input class="form-control" type="search" name="q" value="<c:out value='${recherche}'/>" placeholder="Rechercher un match, une équipe..." aria-label="Rechercher un match ou une équipe"><button class="navbar-search-button" type="submit" aria-label="Rechercher"><svg class="navbar-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></button></form><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link active" href="${pageContext.request.contextPath}/admin/matchs">Matchs</a><a class="nav-link" href="${pageContext.request.contextPath}/admin/reservations">Réservations</a><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav>
<main class="container py-5"><span class="badge text-bg-success mb-2">Administration</span><h1 class="display-6 fw-bold">Gestion des matchs</h1><p class="text-muted-football">Consultez le calendrier et gérez les rencontres, leurs tarifs et les photos des équipes.</p>
<c:if test="${not empty erreur}"><div class="alert alert-danger" role="alert"><c:out value="${erreur}"/></div></c:if>
<c:choose><c:when test="${param.resultat eq 'ajoute'}"><div class="alert alert-success">Le match a été ajouté.</div></c:when><c:when test="${param.resultat eq 'modifie'}"><div class="alert alert-success">Le match a été modifié.</div></c:when><c:when test="${param.resultat eq 'supprime'}"><div class="alert alert-success">Le match a été supprimé.</div></c:when></c:choose>
<section class="card card-football mt-4 mb-5 ${empty matchEnEdition ? 'd-none' : ''}" id="matchFormCard"><div class="card-body p-4"><h2 class="h4 fw-bold mb-3"><c:choose><c:when test="${not empty matchEnEdition}">Modifier un match</c:when><c:otherwise>Ajouter un match</c:otherwise></c:choose></h2>
<form method="post" action="${pageContext.request.contextPath}/admin/matchs" enctype="multipart/form-data"><c:if test="${not empty matchEnEdition}"><input type="hidden" name="id" value="${matchEnEdition.id}"></c:if>
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="equipeDomicile">Équipe à domicile</label><input class="form-control" id="equipeDomicile" name="equipeDomicile" maxlength="150" value="<c:out value='${matchEnEdition.equipeDomicile}'/>" required></div><div class="col-md-6"><label class="form-label" for="equipeExterieure">Équipe extérieure</label><input class="form-control" id="equipeExterieure" name="equipeExterieure" maxlength="150" value="<c:out value='${matchEnEdition.equipeExterieure}'/>" required></div>
<div class="col-md-6"><label class="form-label" for="competition">Compétition</label><input class="form-control" id="competition" name="competition" value="Botola Pro" readonly><div class="form-text"><img src="${pageContext.request.contextPath}/images/logos/botola-pro.png" alt="Logo Botola Pro" width="28" height="28" style="object-fit:contain"> Botola Pro</div></div><div class="col-md-6"><label class="form-label" for="stade">Stade</label><input class="form-control" id="stade" name="stade" maxlength="200" value="<c:out value='${matchEnEdition.stade}'/>" required></div>
<div class="col-md-4"><label class="form-label" for="dateHeure">Date et heure</label><input class="form-control" type="datetime-local" id="dateHeure" name="dateHeure" value="${matchEnEdition.dateHeure}" required></div><div class="col-md-4"><label class="form-label" for="prixCentrale">Tribune centrale (DH)</label><input class="form-control" type="number" id="prixCentrale" name="prixCentrale" min="0" step="0.01" value="${tarifsEdition['Tribune centrale']}" required></div><div class="col-md-4"><label class="form-label" for="prixLaterale">Tribune latérale (DH)</label><input class="form-control" type="number" id="prixLaterale" name="prixLaterale" min="0" step="0.01" value="${tarifsEdition['Tribune latérale']}" required></div><div class="col-md-4"><label class="form-label" for="prixPopulaire">Tribune populaire (DH)</label><input class="form-control" type="number" id="prixPopulaire" name="prixPopulaire" min="0" step="0.01" value="${tarifsEdition['Tribune populaire']}" required></div>
<div class="col-md-6"><label class="form-label" for="photoDomicile">Photo de l’équipe à domicile (PNG, JPEG ou WebP, 5 Mo max.)</label><input class="form-control" type="file" id="photoDomicile" name="photoDomicile" accept="image/png,image/jpeg,image/webp"><c:if test="${not empty matchEnEdition.photoDomicileFichier}"><img class="mt-2 rounded" width="64" height="64" style="object-fit:contain" src="${pageContext.request.contextPath}/admin/photo/domicile?id=${matchEnEdition.id}" alt="Photo actuelle de l’équipe à domicile"></c:if></div>
<div class="col-md-6"><label class="form-label" for="photoExterieure">Photo de l’équipe extérieure (PNG, JPEG ou WebP, 5 Mo max.)</label><input class="form-control" type="file" id="photoExterieure" name="photoExterieure" accept="image/png,image/jpeg,image/webp"><c:if test="${not empty matchEnEdition.photoExterieureFichier}"><img class="mt-2 rounded" width="64" height="64" style="object-fit:contain" src="${pageContext.request.contextPath}/admin/photo/exterieure?id=${matchEnEdition.id}" alt="Photo actuelle de l’équipe extérieure"></c:if></div></div>
<div class="mt-4 d-flex gap-2"><button class="btn btn-football" type="submit"><c:choose><c:when test="${not empty matchEnEdition}">Enregistrer les modifications</c:when><c:otherwise>Ajouter</c:otherwise></c:choose></button><c:choose><c:when test="${not empty matchEnEdition}"><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/matchs">Annuler</a></c:when><c:otherwise><button class="btn btn-outline-secondary" id="cancelMatchForm" type="button">Annuler</button></c:otherwise></c:choose></div></form></div></section>
<section><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 fw-bold mb-0">Matchs enregistrés</h2><c:if test="${empty matchEnEdition}"><button class="btn btn-football" id="showMatchForm" type="button">Ajouter un match</button></c:if></div><c:if test="${empty matchs}"><div class="alert alert-light border"><c:choose><c:when test="${not empty recherche}">Aucun match ne correspond à cette recherche.</c:when><c:otherwise>Aucun match enregistré dans la base de données.</c:otherwise></c:choose></div></c:if><c:if test="${not empty matchs}"><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Rencontre</th><th>Compétition</th><th>Stade et date</th><th>Prix</th><th>Actions</th></tr></thead><tbody><c:forEach var="match" items="${matchs}"><tr><td><div class="d-flex align-items-center gap-2"><c:if test="${not empty match.photoDomicileFichier}"><img width="36" height="36" style="object-fit:contain" src="${pageContext.request.contextPath}/admin/photo/domicile?id=${match.id}" alt=""></c:if><strong><c:out value="${match.equipeDomicile}"/></strong><span>vs</span><c:if test="${not empty match.photoExterieureFichier}"><img width="36" height="36" style="object-fit:contain" src="${pageContext.request.contextPath}/admin/photo/exterieure?id=${match.id}" alt=""></c:if><strong><c:out value="${match.equipeExterieure}"/></strong></div></td><td><c:out value="${match.competition}"/></td><td><c:out value="${match.stade}"/><br><small><c:out value="${match.dateHeureAffichee}"/></small></td><td><c:out value="${match.prix}"/> DH</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/matchs?modifier=${match.id}">Modifier</a> <form class="d-inline" method="post" action="${pageContext.request.contextPath}/admin/matchs" onsubmit="return confirm('Supprimer ce match et ses billets et réservations associés ?');"><input type="hidden" name="id" value="${match.id}"><input type="hidden" name="action" value="supprimer"><button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button></form></td></tr></c:forEach></tbody></table></div></c:if></section>
</main><script>
  const addMatchButton = document.getElementById("showMatchForm");
  const cancelMatchButton = document.getElementById("cancelMatchForm");
  const matchFormCard = document.getElementById("matchFormCard");
  if (addMatchButton && matchFormCard) {
    addMatchButton.addEventListener("click", () => {
      matchFormCard.classList.remove("d-none");
      addMatchButton.hidden = true;
      matchFormCard.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }
  if (cancelMatchButton && matchFormCard && addMatchButton) {
    cancelMatchButton.addEventListener("click", () => {
      matchFormCard.querySelector("form").reset();
      matchFormCard.classList.add("d-none");
      addMatchButton.hidden = false;
    });
  }
</script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
