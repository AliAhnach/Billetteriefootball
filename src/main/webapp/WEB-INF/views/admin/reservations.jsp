<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Administration — Réservations</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css?v=foot-ticket-12" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-football"><div class="container"><a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/admin"><img src="${pageContext.request.contextPath}/images/logos/logo-FootTicket.png" alt="" width="42" height="42"><span class="brand-wordmark" aria-label="FootTicket"><span class="brand-wordmark-foot">Foot</span><span class="brand-wordmark-ticket">Ticket</span></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Ouvrir le menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="adminNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="${pageContext.request.contextPath}/admin/matchs">Matchs</a><a class="nav-link active" href="${pageContext.request.contextPath}/admin/reservations">Réservations</a><span class="nav-link text-white fw-semibold"><c:out value="${sessionScope.nom}"/></span><form method="post" action="${pageContext.request.contextPath}/logout" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Déconnexion</button></form></div></div></div></nav>
<main class="container py-5"><span class="badge text-bg-success mb-2">Administration</span><h1 class="display-6 fw-bold">Gestion des réservations</h1>
<c:if test="${param.resultat eq 'modifie'}"><div class="alert alert-success">La réservation a été mise à jour.</div></c:if><c:if test="${not empty erreur}"><div class="alert alert-danger"><c:out value="${erreur}"/></div></c:if>
<div class="card card-football mt-4"><div class="card-body p-0"><c:if test="${empty reservations}"><p class="p-4 mb-0">Aucune réservation pour le moment.</p></c:if><c:if test="${not empty reservations}"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-4">Réservation</th><th>Client</th><th>Match</th><th>Catégorie</th><th>Places</th><th>Date</th><th>Statut</th><th>Actions</th></tr></thead><tbody><c:forEach var="r" items="${reservations}"><tr><td class="ps-4 fw-semibold">#<c:out value="${r.id}"/></td><td><c:out value="${nomsClients[r.clientId]}"/></td><td><c:out value="${nomsMatchs[r.matchId]}"/></td><td><c:out value="${empty r.categorie ? 'À attribuer' : r.categorie}"/></td><td><c:out value="${r.nombrePlaces}"/></td><td><c:out value="${r.dateReservation}"/></td><td><c:choose><c:when test="${r.statut eq 'EN_ATTENTE'}"><span class="badge text-bg-warning">En attente</span></c:when><c:when test="${r.statut eq 'VALIDEE'}"><span class="badge text-bg-success">Confirmée</span></c:when><c:otherwise><span class="badge text-bg-secondary">Annulée</span></c:otherwise></c:choose></td><td><div class="d-flex flex-wrap gap-2">
<c:if test="${r.statut ne 'ANNULEE' and r.statut ne 'VALIDEE'}"><c:if test="${r.statut ne 'VALIDEE'}"><form method="post" action="${pageContext.request.contextPath}/admin/reservation"><input type="hidden" name="id" value="${r.id}"><input type="hidden" name="action" value="confirmer"><button class="btn btn-success btn-sm" type="submit">Confirmer</button></form></c:if><form method="post" action="${pageContext.request.contextPath}/admin/reservation"><input type="hidden" name="id" value="${r.id}"><input type="hidden" name="action" value="annuler"><button class="btn btn-outline-danger btn-sm" type="submit">Annuler</button></form></c:if></div></td></tr></c:forEach></tbody></table></div></c:if></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><%@ include file="/WEB-INF/views/footer.jspf" %></body></html>
