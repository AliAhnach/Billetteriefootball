<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Connexion</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/app.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-football"><div class="container"><a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/matchs">⚽ Billetterie</a></div></nav><main class="container"><section class="card card-football auth-card"><div class="card-body p-4 p-md-5"><span class="badge text-bg-success mb-2">Espace client</span><h1 class="h2 fw-bold">Ravi de vous revoir</h1><p class="text-muted-football">Connectez-vous pour retrouver vos réservations.</p>
<p class="text-danger">${erreur}</p><form method="post" action="${pageContext.request.contextPath}/login"><div class="mb-3"><label class="form-label" for="email">Adresse e-mail</label><input class="form-control form-control-lg" id="email" type="email" name="email" required></div><div class="mb-4"><label class="form-label" for="password">Mot de passe</label><input class="form-control form-control-lg" id="password" type="password" name="motDePasse" required></div><button class="btn btn-football btn-lg w-100" type="submit">Se connecter</button></form><p class="text-center mt-4 mb-0">Pas encore de compte ? <a href="${pageContext.request.contextPath}/inscription">Inscrivez-vous</a></p></div></section></main></body></html>
